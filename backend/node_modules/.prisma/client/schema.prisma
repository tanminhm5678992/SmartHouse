datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native": chạy trên máy Windows (npm start ở local)
  // "linux-musl-openssl-3.0.x": chạy trong Docker image node:20-alpine (Alpine dùng musl + OpenSSL 3)
  // Phải khai báo tường minh để Prisma luôn tải đúng engine, tránh lỗi thiếu libssl.so.1.1
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// =========================================================
// NGƯỜI DÙNG ĐĂNG NHẬP (AUTH - JWT)
// Mật khẩu luôn được băm bằng bcrypt trước khi lưu, không lưu plain-text
// =========================================================
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(100)
  role         String    @default("user") @db.VarChar(20) // 'admin' | 'user'
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")

  @@map("users")
}

model Device {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  type        String    @db.VarChar(20) // 'relay' | 'led' | 'fan' | 'sensor'
  mqttTopic   String    @map("mqtt_topic") @db.VarChar(100)
  nodeId      String    @map("node_id") @db.VarChar(20)
  pin         String?   @db.VarChar(20) // Ví dụ: 'GPIO 5', 'GPIO 6'
  description String?   @db.VarChar(255) // Hướng dẫn đấu dây chi tiết
  state       String    @default("OFF") @db.VarChar(20)
  brightness  Int       @default(0) // Độ sáng LED (0-100%), chỉ áp dụng cho thiết bị loại 'led'
  lastSeen    DateTime? @map("last_seen")
  createdAt   DateTime  @default(now()) @map("created_at")

  automations Automation[]
  schedules   Schedule[]
  logs        ActivityLog[]

  @@map("devices")
}

model SensorReading {
  id          BigInt   @id @default(autoincrement())
  nodeId      String   @map("node_id") @db.VarChar(20)
  temperature Float
  humidity    Float
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([nodeId, createdAt(sort: Desc)], name: "idx_sensor_time")
  @@map("sensor_readings")
}

model Automation {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  sensorNode     String   @map("sensor_node") @db.VarChar(20)
  metric         String   @db.VarChar(20) // 'temperature' | 'humidity'
  operator       String   @db.VarChar(5) // '>', '<', '>=', '<='
  threshold      Float
  targetDeviceId Int      @map("target_device_id")
  action         String   @db.VarChar(10) // 'ON' | 'OFF'
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  targetDevice Device @relation(fields: [targetDeviceId], references: [id], onDelete: Cascade)

  @@map("automations")
}

// =========================================================
// LỊCH HẸN BẬT/TẮT THIẾT BỊ THEO GIỜ (SCHEDULE)
// =========================================================
model Schedule {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  targetDeviceId Int      @map("target_device_id")
  onTime         String   @map("on_time") @db.VarChar(5) // Giờ bật "HH:MM"
  offTime        String   @map("off_time") @db.VarChar(5) // Giờ tắt "HH:MM"
  days           String   @default("1,2,3,4,5,6,7") @db.VarChar(20) // Các ngày áp dụng (1=Thứ 2 ... 7=Chủ nhật)
  enabled        Boolean  @default(true)
  lastOnRun      String?  @map("last_on_run") @db.VarChar(16) // Chống kích hoạt trùng: "YYYY-MM-DDTHH:MM"
  lastOffRun     String?  @map("last_off_run") @db.VarChar(16) // Chống kích hoạt trùng: "YYYY-MM-DDTHH:MM"
  createdAt      DateTime @default(now()) @map("created_at")

  targetDevice Device @relation(fields: [targetDeviceId], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  deviceId  Int?     @map("device_id")
  action    String   @db.VarChar(100)
  source    String   @db.VarChar(20) // 'auto' | 'manual' | 'HA'
  createdAt DateTime @default(now()) @map("created_at")

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
