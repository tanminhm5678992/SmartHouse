datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Device {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  type        String        @db.VarChar(20) // 'relay' | 'led' | 'sensor'
  mqttTopic   String        @map("mqtt_topic") @db.VarChar(100)
  nodeId      String        @map("node_id") @db.VarChar(20)
  state       String        @default("OFF") @db.VarChar(20)
  lastSeen    DateTime?     @map("last_seen")
  createdAt   DateTime      @default(now()) @map("created_at")
  
  automations Automation[]
  logs        ActivityLog[]

  @@map("devices")
}

model SensorReading {
  id          BigInt   @id @default(autoincrement())
  nodeId      String   @map("node_id") @db.VarChar(20)
  temperature Float
  humidity    Float
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([nodeId, createdAt(sort: Desc)], name: "idx_sensor_time")
  @@map("sensor_readings")
}

model Automation {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  sensorNode     String   @map("sensor_node") @db.VarChar(20)
  metric         String   @db.VarChar(20) // 'temperature' | 'humidity'
  operator       String   @db.VarChar(5)  // '>', '<', '>=', '<='
  threshold      Float
  targetDeviceId Int      @map("target_device_id")
  action         String   @db.VarChar(10) // 'ON' | 'OFF'
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  targetDevice   Device   @relation(fields: [targetDeviceId], references: [id], onDelete: Cascade)

  @@map("automations")
}

model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  deviceId  Int?     @map("device_id")
  action    String   @db.VarChar(100)
  source    String   @db.VarChar(20) // 'auto' | 'manual' | 'HA'
  createdAt DateTime @default(now()) @map("created_at")

  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}
