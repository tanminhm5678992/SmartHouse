PORT=4000

# 1. Kết nối CSDL PostgreSQL:
# - Nếu dùng PostgreSQL trên Windows: cổng 5432 (thay 'secretpassword' bằng mật khẩu postgres của bạn nếu có)
# - Nếu dùng PostgreSQL Docker: cổng 5433
DATABASE_URL=postgres://postgres:secretpassword@localhost:5432/smarthome?schema=public

# 2. Kết nối MQTT Broker (EMQX chạy trên Docker):
MQTT_BROKER_URL=mqtt://localhost:1883

# 3. Địa chỉ Frontend React:
CLIENT_URL=http://localhost:3000
