PORT=4000

# 1. Kết nối CSDL PostgreSQL:
# - Nếu dùng PostgreSQL trên Windows: cổng 5432 (thay 'secretpassword' bằng mật khẩu postgres của bạn nếu có)
# - Nếu dùng PostgreSQL Docker: cổng 5433
DATABASE_URL=postgres://postgres:secretpassword@localhost:5433/smarthome?schema=public

# 2. Kết nối MQTT Broker Server (Slide 19: Backend chỉ kết nối vào Broker Server):
# - Khi chạy máy thật: mqtt://localhost:1884
# - Khi chạy trong Docker: mqtt://broker_server:1883
MQTT_BROKER_URL=mqtt://localhost:1884

# 3. Địa chỉ Frontend React:
CLIENT_URL=http://localhost:3000
